      "character": "Elena",
      "voice_name": "Sarah",
      "voice_id": "EXAVITQu4vr4xnSDxMaL",
      "text": "Siapa tahu pas mengebor, malah ketemu batu opal harga miliaran!",
      "file": "audio/clips/09_elena_dialog.wav",
      "start_sec": 47.956,
      "end_sec": 50.333,
      "duration_sec": 2.377,
