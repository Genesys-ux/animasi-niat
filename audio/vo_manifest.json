      "character": "Maya",
      "voice_name": "Jessica",
      "voice_id": "cgSgspJ2msm6clMCkdW9",
      "text": "Bisa berangkat sekolah pakai kaus pas di luar minus dua puluh derajat!",
      "file": "audio/clips/05_maya_dialog.wav",
      "start_sec": 24.77,
      "end_sec": 27.561,
